# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=steellink

# Server Configuration
PORT=8080
GIN_MODE=debug

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=24h

# Default admin account for local development only
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_REAL_NAME=Platform Admin

# Log Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# AI procurement model secret status check.
# The admin UI stores API key env var names only; set the real key on the backend host.
# MINIMAX_API_KEY=your-minimax-api-key

# AI procurement vector retrieval status/config reference.
# The admin UI stores vector collection names and connection metadata, not secrets.
# MILVUS_ENDPOINT=localhost:19530
# MILVUS_PASSWORD=your-milvus-password
