# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=steellink

# Server Configuration
PORT=8080
GIN_MODE=debug

# Redis Configuration
# Admin writes AI procurement runtime config to this Redis DB.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE=24h

# Default admin account for local development only
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_REAL_NAME=Platform Admin

# Log Configuration
LOG_LEVEL=debug
LOG_FORMAT=json

# Tencent COS private file preview
COS_REGION=ap-beijing
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BUCKET=steellink-public-1321917249
COS_PUBLIC_BASE_URL=https://steellink-public-1321917249.cos.ap-beijing.myqcloud.com
COS_PRIVATE_BUCKET=steellink-user-pri-1321917249
COS_ADMIN_BUCKET=steellink-admin-1321917249
COS_PRIVATE_URL_EXPIRES_SECONDS=600

# AI procurement model secret status check.
# The admin UI stores API key env var names only; set the real key on the backend host.
# MINIMAX_API_KEY=your-minimax-api-key
# MINIMAX_TOKEN_PLAN_API_KEY=your-minimax-token-plan-key

# AI procurement vector retrieval status/config reference.
# The admin UI stores pgvector table names and connection metadata, not secrets.
# PGVECTOR_DSN=postgres://user:password@host:5432/steellink_vectors?sslmode=disable
# PGVECTOR_PASSWORD=your-pgvector-password

# Optional token for manually inspecting the internal runtime config endpoint.
# SteelLink-backend no longer uses this endpoint for runtime config.
# AI_PROCUREMENT_CONFIG_SYNC_TOKEN=shared-internal-token
